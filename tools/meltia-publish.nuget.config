<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources ONLY for Windows publishing.
  The root nuget.config remains offline (<clear/>) for inherited core tests.
  This file never modifies the user's global NuGet configuration.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
