<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0-dev</Version>
    <Description>Meltia v1.0 experimental boundary Core (not an IME release)</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- H11 research-only: existing Meltype lexicon, fixed before this comparison. -->
    <EmbeddedResource Include="../../dictionaries/english.txt" LogicalName="Meltia.H11EnglishWords" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests require direct deterministic pruning checks without public API. -->
    <InternalsVisibleTo Include="Meltia.Core.Tests" />
  </ItemGroup>
</Project>
