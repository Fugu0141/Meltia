<Project Sdk="Microsoft.NET.Sdk">
  <!-- An independent executable compiled from reused Meltype Windows code.
       No inherited TSF registration, installer or self-updater is shipped. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Meltia</AssemblyName>
    <RootNamespace>Meltype</RootNamespace>
    <DefineConstants>$(DefineConstants);MELTIA_PREVIEW</DefineConstants>
    <Version>1.0.0-dev</Version>
    <Product>Meltia Windows Keyboard Preview</Product>
    <Authors>Meltia contributors; Yukishiro (original Meltype)</Authors>
    <Copyright>Copyright (C) 2026 original Meltype and Meltia contributors. GPL-3.0-or-later</Copyright>
    <Description>Meltia standalone keyboard preview with Meltype composition reuse</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Meltype/**/*.cs"
             Exclude="../Meltype/**/obj/**/*.cs;../Meltype/**/bin/**/*.cs" />
    <Compile Include="*.cs" />
    <ProjectReference Include="../Meltype.Core/Meltype.Core.csproj" />
    <ProjectReference Include="../Meltia.Core/Meltia.Core.csproj" />
    <ProjectReference Include="../Meltia.CompositionBridge/Meltia.CompositionBridge.csproj" />
  </ItemGroup>
</Project>
